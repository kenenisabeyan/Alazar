{
  "name": "alazar-portfolio",
  "private": true,
  "version": "2.0.0",
  "description": "Alazar Asdesach Portfolio — pure PERN stack (PostgreSQL, Express, React, Node.js)",
  "scripts": {
    "frontend": "npm run dev --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "dev": "npm run backend & npm run frontend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "build": "cd frontend && npm install && npm run build",
    "vercel-build": "cd frontend && npm install && npm run build",
    "seed": "npm run seed --prefix backend"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.11",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "pg": "^8.12.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "6.30.6",
    "tailwind-merge": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.2.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}